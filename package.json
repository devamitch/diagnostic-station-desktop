  "name": "diagnostic-station-desktop",
  "description": "AI Eye Health Monitoring",
  "version": "1.0.44",
  "author": {
    "name": "Amit Chakraborty",
    "email": "amit98ch@gmail.com",
    "url": "https://github.com/devamitch"
  },
  "contributors": [
