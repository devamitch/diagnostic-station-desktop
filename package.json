  "repository": {
    "type": "git",
    "url": "https://github.com/AuraCore-Medical-Technologies-Inc/project-olo-nextron.git"
  },
  "main": "app/background.js",
  "scripts": {
    "dev": "nextron",
    "generate-icons": "electron-icon-builder --input=./renderer/public/logo.png --output=./build --flatten",
    "prebuild": "yarn generate-icons",
    "postinstall": "electron-builder install-app-deps",
    "build": "dotenv -e .env -- nextron build --mac --win --linux",
    "build:all": "yarn build:win:all && yarn build:linux:all && yarn build:mac:all",
    "build:mac": "dotenv -e .env -- nextron build --mac",
    "build:mac:test": "CSC_IDENTITY_AUTO_DISCOVERY=false dotenv -e .env -- nextron build --mac -c.mac.notarize=false",
    "build:mac:x64": "dotenv -e .env -- nextron build --mac --x64",
    "build:mac:arm64": "dotenv -e .env -- nextron build --mac --arm64",
    "build:mac:universal": "dotenv -e .env -- nextron build --mac --universal",
    "build:mac:all": "yarn build:mac:x64 && yarn build:mac:arm64 && yarn build:mac:universal",
    "build:win": "dotenv -e .env -- nextron build --win",
    "build:win:x64": "dotenv -e .env -- nextron build --win --x64",
    "build:win:ia32": "dotenv -e .env -- nextron build --win --ia32",
    "build:win:arm64": "dotenv -e .env -- nextron build --win --arm64",
    "build:win:all": "yarn build:win:x64 && yarn build:win:ia32 && yarn build:win:arm64",
    "build:linux": "dotenv -e .env -- nextron build --linux",
    "build:linux:x64": "dotenv -e .env -- nextron build --linux --x64",
    "build:linux:arm64": "dotenv -e .env -- nextron build --linux --arm64",
    "build:linux:armv7l": "dotenv -e .env -- nextron build --linux --armv7l",
    "build:linux:all": "yarn build:linux:x64 && yarn build:linux:arm64 && yarn build:linux:armv7l",
    "build:linux:deb": "dotenv -e .env -- nextron build --linux deb",
    "build:linux:rpm": "dotenv -e .env -- nextron build --linux rpm",
    "build:linux:appimage": "dotenv -e .env -- nextron build --linux AppImage",
    "build:linux:snap": "dotenv -e .env -- nextron build --linux snap",
    "build:linux:flatpak": "dotenv -e .env -- nextron build --linux flatpak",
    "build:linux:pacman": "dotenv -e .env -- nextron build --linux pacman",
    "publish:mac": "dotenv -e .env -- nextron build --mac --publish always",
    "publish:win": "dotenv -e .env -- nextron build --win --x64 --publish always",
    "publish:linux": "dotenv -e .env -- nextron build --linux --publish always",
    "publish:all": "dotenv -e .env -- nextron build --mac --linux --win --publish always"
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.6.1",
    "@gumlet/react-embed-player": "^2.0.19",
    "@hookform/resolvers": "^5.2.2",
    "@svgr/webpack": "^8.1.0",
    "@tanstack/react-query": "^5.90.2",
    "axios": "^1.12.2",
    "bcryptjs": "^3.0.2",
    "crypto-js": "^4.2.0",
    "date-fns": "^4.1.0",
    "dompurify": "^3.3.1",
    "electron-log": "^5.4.3",
    "electron-serve": "^3.0.0",
    "electron-store": "^8.2.0",
    "electron-updater": "6.6.2",
    "firebase": "^12.1.0",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.2.2",
    "immer": "^10.1.3",
    "jose": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "next": "15.4.10",
    "next-intl": "^4.3.7",
    "next-lazy-hydrate": "^1.1.0",
    "next-pwa": "^5.6.0",
    "node-cron": "^4.2.1",
    "ramda": "^0.31.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-error-boundary": "^6.0.0",
    "react-hook-form": "^7.64.0",
    "react-intersection-observer": "^9.16.0",
    "react-modal": "^3.16.3",
    "recharts": "^3.2.1",
    "sass": "^1.93.2",
    "sonner": "^2.0.7",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/crypto-js": "^4.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/next-pwa": "^5.6.9",
    "@types/node": "^20.19.10",
    "@types/node-cron": "^3.0.11",
    "@types/ramda": "^0.31.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^10.0.0",
    "electron": "^38.2.1",
    "electron-builder": "^26.0.12",
    "electron-icon-builder": "^2.0.1",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.33.0",
    "eslint-config-next": "15.4.2",
    "nextron": "^9.5.0",
    "postcss": "^8.4.38",
    "prettier": "3.6.2",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.9.2"
  },
  "license": "MIT",
  "homepage": "https://github.com/devamitch/diagnostic-station-desktop#readme"
}
